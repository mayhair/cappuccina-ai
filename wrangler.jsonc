{
  "name": "cappuccina-frontend",
  "compatibility_date": "2026-09-28",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "API_ORIGIN": "https://cappuccina-api.mayhair.net" }
}
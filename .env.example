# Frontend build settings. Copy to .env in the repository root. They are read at
# build time, so run `npm run build && npx wrangler deploy` after changing them.

# Public Turnstile site key for the sign-up form. Required when the backend has
# TURNSTILE_SECRET_KEY set, or sign-up fails. Cloudflare's test key (always passes):
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

# Match these to GOOGLE_AUTH_ENABLED and PASSWORD_AUTH_ENABLED in backend/.env.
# Set to false to hide that sign-in method.
# VITE_AUTH_GOOGLE=true
# VITE_AUTH_PASSWORD=true

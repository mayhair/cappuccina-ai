OPENAI_API_KEY=sk-...
BRAVE_API_KEY=your-brave-key
MODEL_ID=gpt-5.6-luna

# Google OAuth (OAuth 2.0 Web application client in Google Cloud Console).
# Register these redirect URIs for the client:
#   http://localhost:5173/api/v1/auth/google/callback
#   http://localhost:5173/api/v1/gmail/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Encrypts Gmail access/refresh tokens at rest. Any string works.
# Generate with: openssl rand -hex 32
TOKEN_ENC_KEY=

# Origin users browse (the Vite dev server). Redirect URIs and post-login
# redirects are built from this.
APP_ORIGIN=http://localhost:5173

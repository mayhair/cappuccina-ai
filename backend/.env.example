# PostgreSQL connection (libpq URL). The default below matches the compose.yaml
# at the repo root (`podman compose up -d`). On a server using the local Unix
# socket with peer auth, leave the host empty: postgresql:///cappuccina
DATABASE_URL=postgresql://cappuccina:cappuccina@127.0.0.1:5432/cappuccina
# The test suite uses its own database (created automatically) and wipes it:
# TEST_DATABASE_URL=postgresql://cappuccina:cappuccina@127.0.0.1:5432/cappuccina_test

OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
PARALLEL_API_KEY=your-parallel-key
MODEL_ID='deepseek/deepseek-v4.1-flash-1017'
# Optional separate model for chat titles. Falls back to MODEL_ID when unset.
# TITLE_MODEL_ID='inclusionai/ling-3.0-flash'

# Image generation/editing for the generate_image and image_edit agent tools.
IMAGE_MODEL_ID=gpt-image-2.5-flare

# Attach a lore character's official look (lore/characters/refs/{id}.png) when
# the model names them, so drawings stay consistent. Set to 0 to disable.
CHARACTER_REF_IMAGES=1

# Offer the optional 18+ "Adult mode" in Settings. Set to 0 to remove the
# option: the Settings section disappears and the backend ignores the flag.
ADULT_MODE_ENABLED=1

# Story mode (interactive roleplay), on by default. Set to 0 to remove it: the
# mode picker and Settings section disappear, the API refuses story chats, and
# existing story chats carry on as ordinary chats.
STORY_MODE_ENABLED=1

# Gmail and Google Calendar integrations, off by default. Set to 1 to bring one
# back: its agent tools, routes and Settings → Connections form all return.
# While one is off, every startup deletes all users' grants for it (and revokes
# them at Google), so users must connect again after it's turned back on.
GMAIL_ENABLED=0
CALENDAR_ENABLED=0

# Text-to-speech for reading assistant replies aloud (Fish Audio).
# Leave FISH_API_KEY empty to disable the feature. The voice/model defaults
# live in app/config.py; override here to use a different voice.
FISH_API_KEY=
# FISH_TTS_REFERENCE_ID=e9f4485fdde24821835dfe129d3c22b0
# FISH_TTS_MODEL=s2.1-pro-free

# Google OAuth (OAuth 2.0 Web application client in Google Cloud Console).
# Register these redirect URIs for the client:
#   http://localhost:5173/api/v1/auth/google/callback
#   http://localhost:5173/api/v1/gmail/callback
#   http://localhost:5173/api/v1/calendar/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Set to 0 to refuse Google sign-in. Gmail and Calendar connections keep using
# the client above. To hide the button, set VITE_AUTH_GOOGLE=false in the root .env.
# GOOGLE_AUTH_ENABLED=1

# Email + password sign-in, offered next to Google (on by default). Set to 0 to
# refuse the routes. To hide the form, set VITE_AUTH_PASSWORD=false in the root .env.
# PASSWORD_AUTH_ENABLED=1
# Cloudflare Turnstile guards sign-up. Leave empty to skip the check in local
# dev, or use Cloudflare's test keys (always pass). The site key goes in the root
# .env as VITE_TURNSTILE_SITE_KEY:
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
# Outgoing mail for confirmation and reset links. Defaults to the send-only
# Postfix on this host (SETUP.md); any SMTP relay works through these.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=25
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=0
MAIL_FROM="Cappuccina <no-reply@localhost>"
# Sign-in attempts per minute, per IP and per email address.
# AUTH_RATE_LIMIT_PER_MINUTE=10

# FMHY free-media guide, reached over MCP (Streamable HTTP). Adds the
# fmhy_media_sites / fmhy_search / fmhy_get_links / fmhy_get_section /
# fmhy_list_sections tools.
# Set to an empty value to disable the free-media tools.
FMHY_MCP_URL=https://fmhy-mcp.ken.tools/mcp

# Encrypts Google access/refresh tokens at rest. Any string works.
# Generate with: openssl rand -hex 32
TOKEN_ENC_KEY=

# Origin users browse (the Vite dev server). Redirect URIs and post-login
# redirects are built from this.
APP_ORIGIN=http://localhost:5173

# Webpage workspaces: each chat's site is a real folder on disk driven through
# a container; the database keeps only a registry row. Defaults shown.
# Container CLI used to run the site containers; `docker` works the same way.
# SITE_CONTAINER_CLI=podman
# A site's container is stopped after this many idle minutes and restarted on
# the next command.
# SITE_IDLE_MINUTES=10
# Default timeout (seconds) for the webpage_shell tool.
# SITE_EXEC_TIMEOUT=120
# Timeout (seconds) for a site's `npm run build`.
# SITE_BUILD_TIMEOUT=300

# Max chat/TTS requests per user per minute
# RATE_LIMIT_PER_MINUTE=10

OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
PARALLEL_API_KEY=your-parallel-key
MODEL_ID='z-ai/glm-5.3-flash'
# Optional separate model for chat titles. Falls back to MODEL_ID when unset.
# TITLE_MODEL_ID='inclusionai/ling-3.0-flash'

# Image generation/editing for the generate_image and image_edit agent tools.
IMAGE_MODEL_ID=gpt-image-2.5-flare

# Text-to-speech for reading assistant replies aloud (Fish Audio).
# Leave FISH_API_KEY empty to disable the feature. The voice/model defaults
# live in app/config.py; override here to use a different voice.
FISH_API_KEY=
# FISH_TTS_REFERENCE_ID=6c273b36364b415ea25e588b688c506d
# FISH_TTS_MODEL=s2.1-pro-free

# Google OAuth (OAuth 2.0 Web application client in Google Cloud Console).
# Register these redirect URIs for the client:
#   http://localhost:5173/api/v1/auth/google/callback
#   http://localhost:5173/api/v1/gmail/callback
#   http://localhost:5173/api/v1/calendar/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Encrypts Google access/refresh tokens at rest. Any string works.
# Generate with: openssl rand -hex 32
TOKEN_ENC_KEY=

# Origin users browse (the Vite dev server). Redirect URIs and post-login
# redirects are built from this.
APP_ORIGIN=http://localhost:5173

OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
PARALLEL_API_KEY=your-parallel-key
MODEL_ID='deepseek/deepseek-v4.1-flash-1017'
# Optional separate model for chat titles. Falls back to MODEL_ID when unset.
# TITLE_MODEL_ID='inclusionai/ling-3.0-flash'

# Image generation/editing for the generate_image and image_edit agent tools.
IMAGE_MODEL_ID=gpt-image-2.5-flare

# Attach a lore character's official look (lore/characters/refs/{id}.png) when
# the model names them, so drawings stay consistent. Set to 0 to disable.
CHARACTER_REF_IMAGES=1

# Offer the optional 18+ "Adult mode" in Settings. Set to 0 to remove the
# option: the Settings section disappears and the backend ignores the flag.
ADULT_MODE_ENABLED=1

# Text-to-speech for reading assistant replies aloud (Fish Audio).
# Leave FISH_API_KEY empty to disable the feature. The voice/model defaults
# live in app/config.py; override here to use a different voice.
FISH_API_KEY=
# FISH_TTS_REFERENCE_ID=e9f4485fdde24821835dfe129d3c22b0
# FISH_TTS_MODEL=s2.1-pro-free

# Google OAuth (OAuth 2.0 Web application client in Google Cloud Console).
# Register these redirect URIs for the client:
#   http://localhost:5173/api/v1/auth/google/callback
#   http://localhost:5173/api/v1/gmail/callback
#   http://localhost:5173/api/v1/calendar/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# FMHY free-media guide, reached over MCP (Streamable HTTP). Adds the
# fmhy_media_sites / fmhy_search / fmhy_get_links / fmhy_get_section /
# fmhy_list_sections tools.
# Set to an empty value to disable the free-media tools.
FMHY_MCP_URL=https://fmhy-mcp.ken.tools/mcp

# Encrypts Google access/refresh tokens at rest. Any string works.
# Generate with: openssl rand -hex 32
TOKEN_ENC_KEY=

# Origin users browse (the Vite dev server). Redirect URIs and post-login
# redirects are built from this.
APP_ORIGIN=http://localhost:5173

# Webpage workspaces: each chat's site is a real folder on disk driven through
# a container; SQLite keeps only a registry row. Defaults shown.
# Container CLI used to run the site containers; `docker` works the same way.
# SITE_CONTAINER_CLI=podman
# A site's container is stopped after this many idle minutes and restarted on
# the next command.
# SITE_IDLE_MINUTES=10
# Default timeout (seconds) for the webpage_shell tool.
# SITE_EXEC_TIMEOUT=120
# Timeout (seconds) for a site's `npm run build`.
# SITE_BUILD_TIMEOUT=300
